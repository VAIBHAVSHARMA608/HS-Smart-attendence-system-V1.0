# MongoDB Atlas connection string (free M0 cluster is enough for this app).
# Get it from Atlas → Database → Connect → Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hssmart?retryWrites=true&w=majority

# Used to sign login JWTs. Set this to a long random string and keep it private.
JWT_SECRET=change-me-to-a-long-random-string

# Only used by Backend/server.js for local dev; Vercel ignores this.
PORT=4000
